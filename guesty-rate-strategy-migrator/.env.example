# ── Playwright ────────────────────────────────────────────────────────────────
# Set to 'false' to show the browser window during development
HEADLESS=true

# Timeout per individual Playwright action (milliseconds)
BROWSER_TIMEOUT_MS=15000

# Timeout for a complete migration job (milliseconds, default 10 minutes)
JOB_TIMEOUT_MS=600000

# ── Redis (for Bull queue) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PostgreSQL (for durable job history) ──────────────────────────────────────
# Jobs are stored in the rate_strategy_migrator schema (isolated from other apps)
DATABASE_URL=postgresql://user:password@localhost:5432/guesty_migrate

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex key used to encrypt email/password in Bull queue payloads.
# Generate with: openssl rand -hex 32
PAYLOAD_ENCRYPTION_KEY=

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to 'true' to cross-check Open API strategy count against the Guesty UI
ENABLE_UI_VALIDATION=false

# Guesty dashboard base URL — override if Guesty changes their domain
GUESTY_APP_URL=https://app.guesty.com
