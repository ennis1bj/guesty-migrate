{
  "name": "guesty-rate-strategy-migrator",
  "version": "1.0.0",
  "description": "Playwright-driven microservice for migrating Guesty Rate Strategies between accounts via browser automation",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "test": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.44.0",
    "axios": "^1.6.2",
    "bull": "^4.16.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.11.3",
    "pino": "^9.6.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
